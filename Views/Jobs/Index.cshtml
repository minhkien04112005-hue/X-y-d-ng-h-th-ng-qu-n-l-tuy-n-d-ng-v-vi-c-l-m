@model IEnumerable<RecruitmentAPI.Models.Job>
@{
    ViewData["Title"] = "Danh sách việc làm";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-4">
    <!-- Thanh tìm kiếm (FR-02) -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <form method="get" asp-controller="Jobs" asp-action="Index" class="row g-3">
                <div class="col-md-9">
                    <label class="form-label fw-bold">Từ khóa tuyển dụng</label>
                    <input type="text" name="keyword" value="@Context.Request.Query["keyword"]" 
                           class="form-control" placeholder="Nhập tên vị trí việc làm (ví dụ: .NET, React, Tester)..." />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100 fw-bold">
                        <i class="bi bi-search me-1"></i> Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Tiêu đề danh sách -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Việc làm mới nhất</h5>
        <span class="text-muted small">Tìm thấy @(Model?.Count() ?? 0) vị trí</span>
    </div>

    <!-- Danh sách thẻ công việc -->
    <div class="row g-3">
        @if (Model != null && Model.Any())
        {
            @foreach (var job in Model)
            {
                bool isClosed = job.IsDeleted || job.Deadline < DateTime.Now;
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                            <div>
                                <h5 class="card-title fw-bold text-primary mb-1">@job.Title</h5>
                                <div class="d-flex flex-wrap gap-3 text-muted small mt-2">
                                    <span><i class="bi bi-calendar-event me-1"></i> Ngày tạo: @job.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    <span><i class="bi bi-hourglass-split me-1"></i> Hạn nộp: @job.Deadline.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                            <div class="text-md-end mt-3 mt-md-0">
                                @if (isClosed)
                                {
                                    <span class="badge bg-secondary mb-2 d-inline-block">Đã đóng</span>
                                    <div>
                                        <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-secondary btn-sm">Xem chi tiết</a>
                                    </div>
                                }
              else
                                {
                                    <span class="badge bg-success mb-2 d-inline-block">Đang tuyển</span>
                                    <div>
                                        <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 bg-white rounded shadow-sm border">
                <p class="text-muted mb-0">Hiện chưa có công việc nào được đăng tải.</p>
            </div>
        }
    </div>
</div>
